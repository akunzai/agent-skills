{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT:-.}/scripts/spoken.sh hook-stop",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT:-.}/scripts/spoken.sh hook-prompt",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT:-.}/scripts/spoken.sh hook-prompt",
        "timeout": 5
      }
    ]
  }
}
