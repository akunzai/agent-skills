{
  "schema_version": 1,
  "rubric_id": "agents-md/representative-task",
  "revision": "agents-md-micromanagement-v1",
  "checks": [
    {
      "id": "required-response-structure",
      "kind": "required_headings",
      "field": "response_text",
      "headings": [
        "Micromanagement Audit",
        "Grounded Findings",
        "Recommendations"
      ],
      "bounded": true
    },
    {
      "id": "grounded-findings",
      "kind": "minimum_context_references",
      "field": "response_text",
      "terms": [
        "Progressive Disclosure",
        "Trust Model Judgment",
        "Single Source of Truth",
        "Rich References",
        "CLAUDE.md"
      ],
      "minimum": 2,
      "bounded": true
    },
    {
      "id": "minimum-grounded-findings",
      "kind": "minimum_grounded_findings",
      "field": "response_text",
      "minimum": 2,
      "per_item": true,
      "required_components": [
        "context_reference",
        "rationale",
        "alternative"
      ],
      "bounded": true
    },
    {
      "id": "no-invented-actions-or-state",
      "kind": "forbid_regex",
      "field": "response_text",
      "patterns": [
        "\\b(I|we) (did |have |has )?(inspected|edited|created|ran|verified|changed|modified)\\b",
        "\\b(I|we) (did |have |has )?(ran|run|executed) ((the |a )?(tests?|commands?|workflow))\\b",
        "\\b(the|this) (file|files|repository|workspace|process|permissions?|command|commands|test|tests|workflow) (was|were|has been|have been|is|are) (inspected|edited|created|modified|updated|verified|changed|run|executed|set|granted|available|clean|ready)\\b"
      ],
      "bounded": true
    }
  ]
}
